<!--
  The Windows installer (ADR 0023): Torqa.exe and its extension in Program Files, a Start-menu
  entry and an uninstaller. Built by the `windows` CI job with WiX:
    wix build -acceptEula wix7 -arch x64 -d Version=<a.b.c.0> -d AppDir=<export folder> Torqa.wxs
  The rider's data lives in %APPDATA% and %LOCALAPPDATA%, so installing over, upgrading or
  uninstalling never touches rides, profiles or settings.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!-- Never change the UpgradeCode: it is how a newer installer finds the version to replace. -->
  <Package
    Name="Torqa"
    Manufacturer="Torqa"
    Version="$(var.Version)"
    UpgradeCode="AA632429-2A34-4633-934D-0CE91A94F45B"
    Scope="perMachine"
    Compressed="yes">
    <!-- Same-version upgrades replace the installed copy, so a reinstalled build never shows
         twice under Installed apps. -->
    <MajorUpgrade
      AllowSameVersionUpgrades="yes"
      DowngradeErrorMessage="A newer version of Torqa is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- The .exe's own icon (ADR 0018) for Installed apps and the shortcut. -->
    <Icon Id="Torqa.exe" SourceFile="$(var.AppDir)\Torqa.exe" />
    <Property Id="ARPPRODUCTICON" Value="Torqa.exe" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/Torqa-Indoor-Cycling/Torqa" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Torqa">
        <Component>
          <File Id="TorqaExe" Source="$(var.AppDir)\Torqa.exe" KeyPath="yes">
            <Shortcut
              Name="Torqa"
              Directory="ProgramMenuFolder"
              WorkingDirectory="INSTALLFOLDER"
              Icon="Torqa.exe"
              Advertise="yes" />
          </File>
        </Component>
        <Component>
          <File Source="$(var.AppDir)\torqa_gd.dll" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
  </Package>
</Wix>
