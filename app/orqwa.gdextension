[configuration]

entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.1
reloadable = true

[libraries]

linux.debug.x86_64 = "res://bin/liborqwa_gd.so"
linux.release.x86_64 = "res://bin/liborqwa_gd.so"
linux.debug.arm64 = "res://bin/liborqwa_gd.so"
linux.release.arm64 = "res://bin/liborqwa_gd.so"
macos.debug = "res://bin/liborqwa_gd.dylib"
macos.release = "res://bin/liborqwa_gd.dylib"
windows.debug.x86_64 = "res://bin/orqwa_gd.dll"
windows.release.x86_64 = "res://bin/orqwa_gd.dll"
